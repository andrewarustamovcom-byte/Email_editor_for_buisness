# Только для владельца backend. Не включать в ZIP расширения.
AI_PROVIDER=mock
HOST=127.0.0.1
PORT=8787
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=aliceai-llm
YANDEX_API_BASE_URL=https://ai.api.cloud.yandex.net
# Настраивается владельцем один раз при сборке; у пользователя настроек нет.
EXTENSION_API_URL=http://127.0.0.1:8787
# Единственный экземпляр backend, постоянный том. Содержит только счётчики.
BUDGET_PATH=var/budget.json
DAILY_TOKEN_LIMIT=200000
LIFETIME_TOKEN_LIMIT=2000000
DAILY_REQUEST_LIMIT=100
MAX_OUTPUT_TOKENS=3000
IP_REQUESTS_PER_MINUTE=6
GLOBAL_REQUESTS_PER_MINUTE=20
MAX_CONCURRENT=2
PROVIDER_TIMEOUT_MS=25000
