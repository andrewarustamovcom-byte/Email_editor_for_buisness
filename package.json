{
  "name": "pisma-personal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/index.ts",
    "dev:fixture": "vite --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node --env-file-if-exists=.env --import tsx scripts/build.ts",
    "build:release": "node --env-file-if-exists=.env --import tsx scripts/build.ts --release",
    "smoke:live": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "smoke:yandex": "node --env-file-if-exists=.env --import tsx scripts/smoke-yandex.ts"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fflate": "0.8.3",
    "esbuild": "^0.28.0",
    "eslint": "10.12.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
